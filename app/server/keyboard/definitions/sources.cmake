# A definition's basename is its exported kb_action_* / kb_effect_* symbol.
# Adding one source file is sufficient; registries are immutable generated C arrays.
# Output: <build>/app/keyboard_definition_registry.c (not tracked source).
# Each generated extern references its descriptor so the linker retains it.
set(_kb_definitions_dir "${CMAKE_CURRENT_LIST_DIR}")
set(_kb_registry "${CMAKE_CURRENT_BINARY_DIR}/keyboard_definition_registry.c")
file(WRITE "${_kb_registry}" "/** Copyright (C) 2026 Nick Hu <huqihan@live.com> */\n/* Generated by app/server/keyboard/definitions/sources.cmake. */\n#include <nos/keyboard_definitions.h>\n")
foreach(_kb_kind action effect)
    if(CMAKE_SCRIPT_MODE_FILE)
        file(GLOB _kb_files "${_kb_definitions_dir}/${_kb_kind}s/*.c")
    else()
        file(GLOB _kb_files CONFIGURE_DEPENDS "${_kb_definitions_dir}/${_kb_kind}s/*.c")
    endif()
    list(SORT _kb_files)
    list(LENGTH _kb_files _kb_${_kb_kind}_count)
    set(_kb_entries "")
    foreach(_kb_file IN LISTS _kb_files)
        get_filename_component(_kb_name "${_kb_file}" NAME_WE)
        file(APPEND "${_kb_registry}" "extern const struct kb_${_kb_kind}_definition kb_${_kb_kind}_${_kb_name};\n")
        string(APPEND _kb_entries "    &kb_${_kb_kind}_${_kb_name},\n")
    endforeach()
    file(APPEND "${_kb_registry}"
        "const struct kb_${_kb_kind}_definition *const kb_${_kb_kind}_definitions[] = {\n${_kb_entries}};\n"
        "const size_t kb_${_kb_kind}_definition_count = sizeof(kb_${_kb_kind}_definitions) / sizeof(kb_${_kb_kind}_definitions[0]);\n")
    list(APPEND APP_SRCS ${_kb_files})
endforeach()

message(STATUS "Keyboard registry: ${_kb_action_count} actions, ${_kb_effect_count} effects -> ${_kb_registry}")

# Kconfig choice guarantees exactly one selected implementation. A new layout
# needs its file plus a KEYBOARD_LAYOUT_<BASENAME> choice in drivers/Kconfig.
if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB _kb_layout_files "${_kb_definitions_dir}/layouts/*.c")
else()
    file(GLOB _kb_layout_files CONFIGURE_DEPENDS "${_kb_definitions_dir}/layouts/*.c")
endif()
set(_kb_selected_layouts 0)
foreach(_kb_layout_file IN LISTS _kb_layout_files)
    get_filename_component(_kb_layout_name "${_kb_layout_file}" NAME_WE)
    string(TOUPPER "${_kb_layout_name}" _kb_layout_symbol)
    if(CONFIG_KEYBOARD_LAYOUT_${_kb_layout_symbol})
        list(APPEND APP_SRCS "${_kb_layout_file}")
        math(EXPR _kb_selected_layouts "${_kb_selected_layouts} + 1")
    endif()
endforeach()
if(NOT _kb_selected_layouts EQUAL 1)
    message(FATAL_ERROR "Select exactly one KEYBOARD_LAYOUT_* definition")
endif()
list(APPEND APP_SRCS "${_kb_registry}" "${_kb_definitions_dir}/profile.c")
