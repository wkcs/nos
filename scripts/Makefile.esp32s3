PYTHON ?= python3
ESP_IDF_PROFILE ?= runtime
ifneq ($(LIBC),idf)
$(error $(PLATFORM) uses LIBC=idf, the ESP-IDF Newlib ABI)
endif
.PHONY: all firmware qemu-test setup-env
all firmware:
	$(PYTHON) scripts/$(PLATFORM).py build --profile $(ESP_IDF_PROFILE) --output $(O)
qemu-test:
	$(PYTHON) tests/$(PLATFORM).py
setup-env:
	$(PYTHON) scripts/$(PLATFORM).py setup
