# Copyright (C) 2026 NOS contributors
PYTHON ?= python3
BUILD_MODE ?= $(if $(filter nk60_v2,$(PLATFORM)),normal,selftest)
MPU ?= 0
SMP ?= 1
PERSISTENCE_TEST ?= 0
EXTRA_APPS ?= 0
NLP_TEST ?= 0
LINUX_COMPAT ?= 0
POSIX_SUITE ?= 0
POSIX_CASE_TICKS ?= 3000
ifeq ($(filter $(BUILD_MODE),selftest normal),)
$(error BUILD_MODE must be selftest or normal)
endif
ARM_PREFIX ?= arm-none-eabi-
ARM64_PREFIX ?= aarch64-linux-gnu-
RISCV_PREFIX ?= riscv64-linux-gnu-
RISCV32_PREFIX ?= riscv64-unknown-elf-
ifeq ($(PLATFORM),arm_virt)
CROSS := $(ARM_PREFIX)
ARCH_DIR := arch/arm
CPUFLAGS := -mcpu=cortex-a15 -marm -mfloat-abi=soft
DEFS := -DNOS_ARM -DNOS_MMU
LINKER := $(ARCH_DIR)/virt.ld
else ifeq ($(PLATFORM),stm32)
CROSS := $(ARM_PREFIX)
ARCH_DIR := arch/arm
CPUFLAGS := -mcpu=cortex-m4 -mthumb -mfloat-abi=soft
DEFS := -DNOS_ARM_M
LINKER := $(ARCH_DIR)/stm32.ld
else ifeq ($(PLATFORM),nk60_v2)
CROSS := $(ARM_PREFIX)
ARCH_DIR := arch/arm
CPUFLAGS := -mcpu=cortex-m4 -mthumb -mfloat-abi=soft
DEFS := -DNOS_ARM_M -DNOS_NK60_V2
LINKER := boards/nk60_v2/nk60_v2.ld
ifneq ($(LIBC),minimal)
$(error nk60_v2 uses the allocation-free minimal keyboard profile)
endif
ifneq ($(SMP),1)
$(error nk60_v2 has one Cortex-M4 core)
endif
ifneq ($(BUILD_MODE),normal)
$(error nk60_v2 uses BUILD_MODE=normal; peripheral models run in host tests)
endif
else ifeq ($(PLATFORM),arm64_virt)
CROSS := $(ARM64_PREFIX)
ARCH_DIR := arch/arm64
CPUFLAGS := -mcpu=cortex-a53 -mno-outline-atomics
KERNELFLAGS := -mgeneral-regs-only
DEFS := -DNOS_ARM64 -DNOS_MMU
LINKER := $(ARCH_DIR)/virt.ld
else ifeq ($(PLATFORM),riscv_virt)
CROSS := $(RISCV_PREFIX)
ARCH_DIR := arch/riscv
CPUFLAGS := -march=rv64gc -mabi=lp64d -mcmodel=medany -mno-relax -msmall-data-limit=0
DEFS := -DNOS_RISCV -DNOS_MMU
LINKER := $(ARCH_DIR)/virt.ld
else ifeq ($(PLATFORM),riscv32_virt)
CROSS := $(RISCV32_PREFIX)
ARCH_DIR := arch/riscv32
CPUFLAGS := -march=rv32gc -mabi=ilp32d -mcmodel=medany -mno-relax -msmall-data-limit=0
DEFS := -DNOS_RISCV -DNOS_RISCV32 -DNOS_MMU
LINKER := $(ARCH_DIR)/virt.ld
else ifeq ($(PLATFORM),riscv32_nommu)
CROSS := $(RISCV32_PREFIX)
ARCH_DIR := arch/riscv32
CPUFLAGS := -march=rv32gc -mabi=ilp32d -mcmodel=medany -mno-relax -msmall-data-limit=0
DEFS := -DNOS_RISCV -DNOS_RISCV32
LINKER := $(ARCH_DIR)/virt_nommu.ld
else
$(error Unsupported PLATFORM=$(PLATFORM))
endif
CC := $(CROSS)gcc
OBJCOPY := $(CROSS)objcopy
ifeq ($(MPU),1)
DEFS += -DNOS_MPU
endif
DEFS += -DNOS_SMP=$(SMP) -DNOS_PERSISTENCE_TEST=$(PERSISTENCE_TEST)
DEFS += -DNOS_EXTRA_APPS=$(EXTRA_APPS)
ifeq ($(LINUX_COMPAT),1)
ifneq ($(filter $(PLATFORM),arm_virt arm64_virt riscv_virt),$(PLATFORM))
$(error LINUX_COMPAT=1 requires arm_virt, arm64_virt or riscv_virt)
endif
ifneq ($(LIBC),minimal)
$(error LINUX_COMPAT=1 uses LIBC=minimal for the built-in native runtime)
endif
DEFS += -DNOS_LINUX_COMPAT
endif
ifeq ($(POSIX_SUITE),1)
ifneq ($(LINUX_COMPAT),1)
$(error POSIX_SUITE=1 requires LINUX_COMPAT=1)
endif
DEFS += -DNOS_POSIX_SUITE -DNOS_POSIX_CASE_TICKS=$(POSIX_CASE_TICKS)
endif
ifeq ($(NLP_TEST),1)
ifneq ($(BUILD_MODE),selftest)
$(error NLP_TEST=1 requires BUILD_MODE=selftest)
endif
DEFS += -DNOS_NLP_TEST
endif
COMMONFLAGS := $(CPUFLAGS) -ffreestanding -fno-builtin -fno-stack-protector -fno-pie -fno-pic -fno-common -ffunction-sections -fdata-sections -fno-tree-loop-distribute-patterns -Wall -Wextra -Werror -std=gnu11 -O2 -g -Iinclude/nos -MMD -MP $(DEFS)
COMMONFLAGS += $(if $(filter selftest,$(BUILD_MODE)),-DNOS_SELFTEST,-DNOS_NORMAL_BOOT)
COMMONFLAGS += $(EXTRA_CFLAGS)
ifeq ($(POSIX_SUITE),1)
COMMONFLAGS += -I$(O)
endif
KERNEL_SRC := kernel/core/core.c kernel/core/runtime.c kernel/core/credentials.c
KERNEL_SRC += kernel/sched/task.c kernel/sched/scheduler.c
KERNEL_SRC += kernel/ipc/ipc.c kernel/ipc/irq.c kernel/ipc/mutex.c
KERNEL_SRC += kernel/mm/memory.c kernel/exec/elf.c kernel/exec/bootfile.c
KERNEL_SRC += kernel/compat/linux/linux.c kernel/compat/linux/linux_signal.c
KERNEL_SRC += $(ARCH_DIR)/platform.c
ifeq ($(LINUX_COMPAT),1)
USER_SRC_LINUX := tests/guest/linux_regression.c
ifeq ($(POSIX_SUITE),1)
USER_SRC_LINUX += tests/guest/posix_suite.c
endif
endif
RUNTIME_SRC := user/lib/syscall.c user/lib/string.c user/lib/process.c user/lib/ipc.c
RUNTIME_SRC += user/lib/fs_path.c user/lib/fs_io.c user/lib/credentials.c user/lib/clock.c
SHELL_SRC := user/shell/parser.c user/shell/editor.c user/shell/commands.c user/shell/shell.c
USER_SRC := $(RUNTIME_SRC) user/lib/thread.c user/lib/posix_poll.c user/init/main.c $(SHELL_SRC)
USER_SRC += servers/vfs/server.c servers/drivers/virtio_blk.c
USER_SRC += servers/drivers/virtio_rng.c servers/drivers/uart.c
USER_SRC += $(USER_SRC_LINUX)
USER_SRC += servers/fatfs/adapter.c
ifneq ($(PLATFORM),stm32)
USER_SRC += servers/fatfs/ff.c
endif
ifeq ($(BUILD_MODE),selftest)
USER_SRC += tests/guest/validation.c tests/guest/libc_regression.c tests/guest/kernel_regression.c tests/guest/arch_regression.c tests/guest/elf_regression.c tests/guest/vfs_regression.c
endif
ifeq ($(PLATFORM),nk60_v2)
KERNEL_SRC += boards/nk60_v2/boot.c
USER_SRC := user/lib/syscall.c user/lib/string.c user/lib/process.c
USER_SRC += servers/keyboard/keyboard.c servers/keyboard/keymap.c servers/keyboard/config.c servers/keyboard/service.c servers/keyboard/link.c servers/keyboard/link_caps.c servers/keyboard/lighting.c servers/keyboard/lighting_fx.c servers/keyboard/link_fx.c servers/keyboard/layout.c servers/keyboard/device.c
USER_SRC += $(wildcard servers/nlp/*/*.c)
USERFLAGS += -Ithird_party/tinycrypt/lib/include
NLP_VENDOR_OBJECTS := $(O)/servers/nlp/vendor/sha256.o $(O)/servers/nlp/vendor/utils.o
USER_SRC += $(wildcard servers/usb/*.c) $(filter-out boards/nk60_v2/boot.c,$(wildcard boards/nk60_v2/*.c))
endif
ifeq ($(NLP_TEST),1)
USER_SRC += tests/guest/nlp_regression.c $(wildcard servers/nlp/*/*.c)
USERFLAGS += -Ithird_party/tinycrypt/lib/include
NLP_VENDOR_OBJECTS := $(O)/servers/nlp/vendor/sha256.o $(O)/servers/nlp/vendor/utils.o
endif
ifneq ($(filter $(PLATFORM),stm32 nk60_v2),)
ASM_SRC := arch/arm/cortex_m.S
else
ASM_SRC := $(ARCH_DIR)/entry.S
endif
ifeq ($(LIBC),newlib)
ifneq ($(filter $(PLATFORM),arm_virt stm32),$(PLATFORM))
$(error Newlib integration currently requires an ARM target)
endif
USER_SRC += libc/port/newlib.c
USER_SRC += libc/port/newlib_pthread.c
USERFLAGS += -Ilibc/port/newlib_include
COMMONFLAGS += -DNOS_NEWLIB -D_POSIX_THREADS=1 -D_UNIX98_THREAD_MUTEX_ATTRIBUTES=1 -D_POSIX_TIMERS=1 -D_POSIX_MONOTONIC_CLOCK=1
NEWLIB_MODE ?= dynamic
ifeq ($(NEWLIB_MODE),dynamic)
NEWLIB_ROOT ?= out/microkernel/newlib/$(PLATFORM)/install
ifeq ($(wildcard $(NEWLIB_ROOT)/lib/libc.a),)
$(error Build dynamic Newlib with scripts/build_newlib.py --platform $(PLATFORM) before using LIBC=newlib)
endif
COMMONFLAGS += -DNOS_NEWLIB_DYNAMIC -D__DYNAMIC_REENT__ -isystem $(NEWLIB_ROOT)/include
USER_LIBS := $(NEWLIB_ROOT)/lib/libc.a
LIBC_ARCHIVE := $(NEWLIB_ROOT)/lib/libc.a
else ifeq ($(NEWLIB_MODE),stock)
USER_LIBS := -lc
LIBC_ARCHIVE := $(shell $(CC) $(CPUFLAGS) -print-file-name=libc.a)
else
$(error NEWLIB_MODE must be dynamic or stock)
endif
else ifeq ($(LIBC),musl)
ifneq ($(filter $(PLATFORM),arm64_virt riscv_virt),$(PLATFORM))
$(error The musl port currently requires ARM64 or RISC-V)
endif
MUSL_ROOT ?= out/microkernel/musl/$(PLATFORM)/install
ifeq ($(wildcard $(MUSL_ROOT)/lib/libc.a),)
$(error Build the musl port with scripts/build_musl.py before using LIBC=musl)
endif
USER_SRC += libc/port/musl.c
COMMONFLAGS += -DNOS_MUSL -isystem $(MUSL_ROOT)/include
USER_LIBS := $(MUSL_ROOT)/lib/libc.a
LIBC_ARCHIVE := $(MUSL_ROOT)/lib/libc.a
else ifneq ($(LIBC),minimal)
$(error LIBC must be minimal, newlib or musl)
endif
ifneq ($(PLATFORM),nk60_v2)
ASM_SRC += tests/guest/$(if $(filter riscv32_virt riscv32_nommu,$(PLATFORM)),rv32_context_probe,context_probe).S
endif
OBJECTS := $(addprefix $(O)/,$(KERNEL_SRC:.c=.o) $(USER_SRC:.c=.o) $(ASM_SRC:.S=.o))
OBJECTS += $(O)/initramfs.o $(NLP_VENDOR_OBJECTS)
LIBGCC_ARCHIVE := $(shell $(CC) $(CPUFLAGS) -print-libgcc-file-name)
KERNEL_LIBGCC := $(O)/kernel-libgcc.a
KERNEL_LIBGCC_SYMBOLS := $(O)/kernel-libgcc.syms
BUILD_SIGNATURE := $(O)/build-config.json
LINKFLAGS ?= -nostdlib -static -no-pie -Wl,--build-id=none,--gc-sections
ifeq ($(LINUX_COMPAT),1)
LINKFLAGS += -Wl,--defsym=NOS_USER_TEMPLATE_LIMIT=131072
endif
make_quote = '$(subst ','"'"',$(1))'
.PHONY: all clean test qemu-test qemu-run FORCE
all: $(O)/nos.elf
$(BUILD_SIGNATURE): FORCE
	@$(PYTHON) scripts/build_signature.py --output $(call make_quote,$@) --compiler $(call make_quote,$(CC)) --value $(call make_quote,platform=$(PLATFORM)) --value $(call make_quote,libc=$(LIBC)) --value $(call make_quote,mode=$(BUILD_MODE)) --value $(call make_quote,cflags=$(COMMONFLAGS)) --value $(call make_quote,kernel_flags=$(KERNELFLAGS)) --value $(call make_quote,user_flags=$(USERFLAGS)) --value $(call make_quote,asm_flags=$(CPUFLAGS) $(DEFS)) --value $(call make_quote,linkflags=$(LINKFLAGS)) --value $(call make_quote,libraries=$(USER_LIBS)) --rule Makefile --rule scripts/Makefile.microkernel --rule scripts/build_signature.py --rule out/microkernel/config.mk $(LINUX_SIGNATURE)
$(KERNEL_LIBGCC) $(KERNEL_LIBGCC_SYMBOLS) &: $(LIBGCC_ARCHIVE) scripts/kernel_libgcc.py $(BUILD_SIGNATURE)
	$(PYTHON) scripts/kernel_libgcc.py --compiler $(CC) $(foreach flag,$(CPUFLAGS),--cpu-flag=$(flag)) --output $(O)
$(O)/nos.elf: $(OBJECTS) $(LINKER) $(LIBC_ARCHIVE) $(LIBGCC_ARCHIVE) $(KERNEL_LIBGCC) $(BUILD_SIGNATURE)
	$(CC) $(CPUFLAGS) $(LINKFLAGS) -Wl,-Map,$(O)/nos.map -T$(LINKER) $(OBJECTS) $(KERNEL_LIBGCC) $(USER_LIBS) -lgcc -o $@
	$(CROSS)size $@
$(O)/%.o: %.c $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(CC) $(COMMONFLAGS) $(if $(filter kernel/% arch/% boards/nk60_v2/boot.c,$<),$(KERNELFLAGS),$(USERFLAGS)) -c $< -o $@
	$(if $(filter kernel/% arch/% boards/nk60_v2/boot.c,$<),$(OBJCOPY) --redefine-syms $(KERNEL_LIBGCC_SYMBOLS) $@,@:)
$(O)/servers/nlp/vendor/%.o: third_party/tinycrypt/lib/source/%.c $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(CC) $(COMMONFLAGS) $(USERFLAGS) -c $< -o $@
$(O)/%.o: %.S $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(CC) $(CPUFLAGS) -fno-pic -fno-pie $(DEFS) -Iinclude/nos -MMD -MP -g -c $< -o $@
	$(if $(filter arch/%,$<),$(OBJCOPY) --redefine-syms $(KERNEL_LIBGCC_SYMBOLS) $@,@:)
$(addprefix $(O)/,$(KERNEL_SRC:.c=.o) $(filter arch/%,$(ASM_SRC:.S=.o))): $(KERNEL_LIBGCC_SYMBOLS)
APP_LINKER := apps/$(if $(filter stm32 riscv32_nommu,$(PLATFORM)),$(PLATFORM),app).ld
APP_PICFLAGS := $(if $(filter stm32 riscv32_nommu,$(PLATFORM)),-fpie,-fno-pie -fno-pic)
M4_APP_LINKFLAGS := -Wl,-pie,--no-dynamic-linker
APP_LINKFLAGS := $(if $(filter stm32 riscv32_nommu,$(PLATFORM)),$(M4_APP_LINKFLAGS),-static -no-pie)
APP_PUBLIC_HEADERS := $(wildcard include/nos/*.h include/nos/sys/*.h include/nos/nlp/*.h libc/port/newlib_include/*.h)
$(O)/apps/hello.elf: apps/start.c apps/hello.c $(APP_LINKER) $(APP_PUBLIC_HEADERS) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
ifeq ($(PLATFORM),riscv32_nommu)
	$(CC) $(CPUFLAGS) $(DEFS) -fpie -ffreestanding -fno-builtin -fno-stack-protector -Iinclude/nos -c apps/start.c -o $(O)/apps/hello_start.o
	$(CC) $(CPUFLAGS) $(DEFS) -fpie -ffreestanding -fno-builtin -fno-stack-protector -Iinclude/nos -c apps/hello.c -o $(O)/apps/hello_main.o
	$(RISCV_PREFIX)ld -m elf32lriscv -pie --no-dynamic-linker --build-id=none -T$(APP_LINKER) $(O)/apps/hello_start.o $(O)/apps/hello_main.o $(LIBGCC_ARCHIVE) -o $@
else
	$(CC) $(CPUFLAGS) $(DEFS) $(APP_PICFLAGS) -ffreestanding -fno-builtin -fno-stack-protector -nostdlib $(APP_LINKFLAGS) -Iinclude/nos -Wl,--build-id=none,-T,$(APP_LINKER) apps/start.c apps/hello.c -lgcc -o $@
endif
INITRAMFS_FILES := --file /bin/hello=$(O)/apps/hello.elf
INITRAMFS_IMAGES := $(O)/apps/hello.elf
ifeq ($(LINUX_COMPAT),1)
LINUX_SYSROOT ?= /workspace/.nos-env/root
LINUX_MANIFEST ?= /workspace/.nos-env/glibc/manifest.json
ifeq ($(PLATFORM),arm_virt)
LINUX_TRIPLE := arm-linux-gnueabi
LINUX_INTERPRETER := ld-linux.so.3
else ifeq ($(PLATFORM),arm64_virt)
LINUX_TRIPLE := aarch64-linux-gnu
LINUX_INTERPRETER := ld-linux-aarch64.so.1
else
LINUX_TRIPLE := riscv64-linux-gnu
LINUX_INTERPRETER := ld-linux-riscv64-lp64d.so.1
endif
LINUX_CC := $(LINUX_TRIPLE)-gcc
LINUX_LIBRARY_ROOT := $(LINUX_SYSROOT)/usr/$(LINUX_TRIPLE)/lib
LINUX_LIBRARIES := $(wildcard $(addprefix $(LINUX_LIBRARY_ROOT)/,$(LINUX_INTERPRETER) libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1 libresolv.so.2 libutil.so.1 libanl.so.1 libnss_dns.so.2 libnss_files.so.2 libgcc_s.so.1))
LINUX_CFLAGS := $(CPUFLAGS) --sysroot=$(LINUX_SYSROOT) -isystem $(LINUX_SYSROOT)/usr/$(LINUX_TRIPLE)/include -Wall -Wextra -Werror -std=gnu11 -O2 -g
LINUX_APP_FLAGS := $(LINUX_CFLAGS) -fPIE -pie -Wl,--build-id=none,--dynamic-linker=/lib/$(LINUX_INTERPRETER)
LINUX_CRT_FILES := $(wildcard $(LINUX_LIBRARY_ROOT)/*crt*.o)
LINUX_SIGNATURE = --value $(call make_quote,linux_flags=$(LINUX_APP_FLAGS)) --rule $(LINUX_MANIFEST) --rule $(shell command -v $(LINUX_CC))
$(O)/apps/nos-linux-gateway.elf: user/compat/linux/gateway.c $(RUNTIME_SRC) user/lib/posix_poll.c apps/linux_gateway.ld $(wildcard include/nos/*.h include/nos/sys/*.h) $(LIBGCC_ARCHIVE) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_CFLAGS) $(if $(filter arm_virt,$(PLATFORM)),-fshort-enums,) $(DEFS) -Iinclude/nos -ffreestanding -fno-builtin -fno-stack-protector -fno-pie -fno-pic -ffunction-sections -fdata-sections -nostdlib -static -no-pie -Wl,--build-id=none,--gc-sections -Tapps/linux_gateway.ld user/compat/linux/gateway.c $(RUNTIME_SRC) user/lib/posix_poll.c $(LIBGCC_ARCHIVE) -o $@
$(O)/apps/glibc_check.elf: tests/guest/apps/glibc_check.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_threads.elf: tests/guest/apps/glibc_threads.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_poll.elf: tests/guest/apps/glibc_poll.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_path4096.elf: tests/guest/apps/glibc_path4096.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_resources.elf: tests/guest/apps/glibc_resources.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_address_space.elf: tests/guest/apps/glibc_address_space.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_capacity.elf: tests/guest/apps/glibc_capacity.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_nproc.elf: tests/guest/apps/glibc_nproc.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_process_capacity.elf: tests/guest/apps/glibc_process_capacity.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_credentials.elf: tests/guest/apps/glibc_credentials.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_permissions.elf: tests/guest/apps/glibc_permissions.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_pipe_atomic.elf: tests/guest/apps/glibc_pipe_atomic.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_signals.elf: tests/guest/apps/glibc_signals.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_process.elf: tests/guest/apps/glibc_process.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_sync.elf: tests/guest/apps/glibc_sync.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_files.elf: tests/guest/apps/glibc_files.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_futex_shared.elf: tests/guest/apps/glibc_futex_shared.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_shared_sync.elf: tests/guest/apps/glibc_shared_sync.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_paths.elf: tests/guest/apps/glibc_paths.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_record_locks.elf: tests/guest/apps/glibc_record_locks.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_record_lock_lifecycle.elf: tests/guest/apps/glibc_record_lock_lifecycle.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/glibc_record_gc.elf: tests/guest/apps/glibc_record_gc.c $(LINUX_LIBRARIES) $(LINUX_CRT_FILES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) $< -pthread -ldl -lm -o $@
$(O)/apps/libnos_probe.so: tests/guest/apps/dynamic/library.c $(LINUX_LIBRARIES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_CFLAGS) -fPIC -shared -nostdlib -Wl,--build-id=none,-soname,libnos_probe.so $< -o $@
$(O)/apps/dynamic_check.elf: tests/guest/apps/dynamic/main.c tests/guest/apps/dynamic/start.S $(O)/apps/libnos_probe.so $(LINUX_LIBRARIES) $(LINUX_MANIFEST) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(LINUX_CC) $(LINUX_APP_FLAGS) -ffreestanding -fno-builtin -fno-stack-protector -nostdlib -Wl,-e,_start,--no-as-needed,-rpath,/lib tests/guest/apps/dynamic/start.S tests/guest/apps/dynamic/main.c -L$(O)/apps -lnos_probe -o $@
INITRAMFS_IMAGES += $(O)/apps/nos-linux-gateway.elf $(O)/apps/glibc_check.elf $(O)/apps/dynamic_check.elf $(O)/apps/libnos_probe.so $(LINUX_LIBRARIES)
INITRAMFS_IMAGES += $(O)/apps/glibc_threads.elf
INITRAMFS_FILES += --file /bin/glibc_threads=$(O)/apps/glibc_threads.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_poll.elf
INITRAMFS_FILES += --file /bin/glibc_poll=$(O)/apps/glibc_poll.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_credentials.elf
INITRAMFS_FILES += --file /bin/glibc_credentials=$(O)/apps/glibc_credentials.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_resources.elf
INITRAMFS_FILES += --file /bin/glibc_resources=$(O)/apps/glibc_resources.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_address_space.elf
INITRAMFS_FILES += --file /bin/glibc_address_space=$(O)/apps/glibc_address_space.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_capacity.elf
INITRAMFS_FILES += --file /bin/glibc_capacity=$(O)/apps/glibc_capacity.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_process_capacity.elf
INITRAMFS_FILES += --file /bin/glibc_process_capacity=$(O)/apps/glibc_process_capacity.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_nproc.elf
INITRAMFS_FILES += --file /bin/glibc_nproc=$(O)/apps/glibc_nproc.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_path4096.elf
INITRAMFS_FILES += --file /bin/glibc_path4096=$(O)/apps/glibc_path4096.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_permissions.elf
INITRAMFS_FILES += --file /bin/glibc_permissions=$(O)/apps/glibc_permissions.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_pipe_atomic.elf
INITRAMFS_FILES += --file /bin/glibc_pipe_atomic=$(O)/apps/glibc_pipe_atomic.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_signals.elf
INITRAMFS_FILES += --file /bin/glibc_signals=$(O)/apps/glibc_signals.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_process.elf
INITRAMFS_FILES += --file /bin/glibc_process=$(O)/apps/glibc_process.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_sync.elf
INITRAMFS_FILES += --file /bin/glibc_sync=$(O)/apps/glibc_sync.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_files.elf
INITRAMFS_FILES += --file /bin/glibc_files=$(O)/apps/glibc_files.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_futex_shared.elf
INITRAMFS_FILES += --file /bin/glibc_futex_shared=$(O)/apps/glibc_futex_shared.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_shared_sync.elf
INITRAMFS_FILES += --file /bin/glibc_shared_sync=$(O)/apps/glibc_shared_sync.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_paths.elf
INITRAMFS_FILES += --file /bin/glibc_paths=$(O)/apps/glibc_paths.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_record_locks.elf
INITRAMFS_FILES += --file /bin/glibc_record_locks=$(O)/apps/glibc_record_locks.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_record_lock_lifecycle.elf
INITRAMFS_FILES += --file /bin/glibc_record_lock_lifecycle=$(O)/apps/glibc_record_lock_lifecycle.elf
INITRAMFS_IMAGES += $(O)/apps/glibc_record_gc.elf
INITRAMFS_FILES += --file /bin/glibc_record_gc=$(O)/apps/glibc_record_gc.elf
INITRAMFS_FILES += --file /lib/nos-linux-gateway.elf=$(O)/apps/nos-linux-gateway.elf --file /bin/glibc_check=$(O)/apps/glibc_check.elf --file /bin/dynamic_check=$(O)/apps/dynamic_check.elf --file /lib/libnos_probe.so=$(O)/apps/libnos_probe.so
INITRAMFS_FILES += $(foreach library,$(LINUX_LIBRARIES),--file /lib/$(notdir $(library))=$(library))
ifeq ($(POSIX_SUITE),1)
include $(O)/posix-files.mk
INITRAMFS_IMAGES += $(POSIX_SUITE_IMAGES)
INITRAMFS_FILES += $(POSIX_SUITE_FILES)
LINUX_SIGNATURE += --rule $(O)/posix_cases.h --rule $(O)/manifest.json
endif
endif
APP_LIBC_SOURCES := apps/start.c apps/libc_start.c $(RUNTIME_SRC) user/lib/thread.c user/lib/posix_poll.c libc/port/$(LIBC).c
APP_LIBC_FLAGS := $(COMMONFLAGS) $(USERFLAGS) -nostdlib -static -no-pie -Wl,--gc-sections,--build-id=none,-z,max-page-size=4096 -T apps/app.ld
ifneq ($(LIBC),minimal)
ifneq ($(PLATFORM),stm32)
$(O)/apps/libc_check.elf: $(APP_LIBC_SOURCES) tests/guest/apps/libc_check.c $(LIBC_ARCHIVE) apps/app.ld $(APP_PUBLIC_HEADERS) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(CC) $(APP_LIBC_FLAGS) $(APP_LIBC_SOURCES) tests/guest/apps/libc_check.c $(USER_LIBS) -lgcc -o $@
INITRAMFS_FILES += --file /bin/libc_check=$(O)/apps/libc_check.elf
INITRAMFS_IMAGES += $(O)/apps/libc_check.elf
endif
endif
ifeq ($(EXTRA_APPS),1)
ifneq ($(LIBC),musl)
$(error EXTRA_APPS=1 requires LIBC=musl)
endif
USERLIB_ROOT := out/microkernel/userlibs/$(PLATFORM)
$(O)/apps/lua.elf: $(APP_LIBC_SOURCES) apps/lua/main.c $(USERLIB_ROOT)/lua/liblua.a $(LIBC_ARCHIVE) apps/app.ld $(APP_PUBLIC_HEADERS) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(CC) $(APP_LIBC_FLAGS) -Ithird_party/lua $(APP_LIBC_SOURCES) apps/lua/main.c $(USERLIB_ROOT)/lua/liblua.a $(USER_LIBS) -lgcc -o $@
$(O)/apps/lvgl.elf: $(APP_LIBC_SOURCES) apps/lvgl/main.c apps/lvgl/lv_conf.h $(USERLIB_ROOT)/lvgl/liblvgl.a $(LIBC_ARCHIVE) apps/app.ld $(APP_PUBLIC_HEADERS) $(BUILD_SIGNATURE)
	@mkdir -p $(dir $@)
	$(CC) $(APP_LIBC_FLAGS) -DLV_CONF_INCLUDE_SIMPLE -Iapps/lvgl -Ithird_party/lvgl $(APP_LIBC_SOURCES) apps/lvgl/main.c $(USERLIB_ROOT)/lvgl/liblvgl.a $(USER_LIBS) -lgcc -o $@
INITRAMFS_FILES += --file /bin/lua=$(O)/apps/lua.elf --file /bin/lvgl=$(O)/apps/lvgl.elf
INITRAMFS_IMAGES += $(O)/apps/lua.elf $(O)/apps/lvgl.elf
endif
ifeq ($(PLATFORM),nk60_v2)
INITRAMFS_IMAGES :=
INITRAMFS_FILES :=
endif
$(O)/initramfs.c: $(INITRAMFS_IMAGES) scripts/embed_initramfs.py
	$(PYTHON) scripts/embed_initramfs.py --output $@ $(INITRAMFS_FILES) $(if $(filter selftest,$(BUILD_MODE)),--negative-fixtures,) $(if $(filter 1,$(LINUX_COMPAT)),--path-max 256,)
$(O)/initramfs.o: $(O)/initramfs.c $(BUILD_SIGNATURE)
	$(CC) $(COMMONFLAGS) $(KERNELFLAGS) -c $< -o $@
%_defconfig:
	@test -f configs/$@ || { echo "Unknown configuration: $@"; exit 1; }
	@mkdir -p out/microkernel
	cp configs/$@ out/microkernel/config.mk
test qemu-test:
	$(PYTHON) tests/qemu_matrix.py
qemu-run: $(O)/nos.elf
	$(PYTHON) scripts/run_qemu.py --platform $(PLATFORM) --image $(O)/nos.elf
ifeq ($(PLATFORM),nk60_v2)
.PHONY: firmware flash
firmware: $(O)/nos.bin $(O)/nos.hex
$(O)/nos.bin: $(O)/nos.elf
	$(OBJCOPY) -O binary $< $@
$(O)/nos.hex: $(O)/nos.elf
	$(OBJCOPY) -O ihex $< $@
flash: firmware
	$(PYTHON) scripts/flash_nk60_v2.py --image $(O)/nos.elf
endif
clean:
	rm -rf $(O)
-include $(OBJECTS:.o=.d)

.PHONY: nlp-tools
nlp-tools:
	$(MAKE) -f apps/nlp-host/Makefile
