TARGET = nos

RM := rm -rf

#定义工具链
# 编译器检测和设置
ifeq ($(CONFIG_CC_IS_CLANG),y)
    # Clang 编译器配置
    CC_NAME := clang
    CXX_NAME := clang++
    # 检查是否有架构前缀的 clang
    ifneq ($(shell which $(PREFIX)clang 2>/dev/null),)
        CC := $(PREFIX)clang
        CXX := $(PREFIX)clang++
    else
        CC := clang
        CXX := clang++
        # 对于 Clang，需要指定目标架构
        ifeq ($(ARCH),arm)
            CC += --target=arm-none-eabi
            CXX += --target=arm-none-eabi
        endif
        ifeq ($(ARCH),arm64)
            CC += --target=aarch64-none-elf
            CXX += --target=aarch64-none-elf
        endif
    endif
else
    # GCC 编译器配置（默认）
    CC_NAME := gcc
    CXX_NAME := g++
    CC := $(PREFIX)gcc
    CXX := $(PREFIX)g++
endif

# 通用工具链（通常使用 GNU binutils）
LD		    := $(PREFIX)ld
AR		    := $(PREFIX)ar
AS		    := $(PREFIX)as
OBJCOPY		:= $(PREFIX)objcopy
OBJDUMP		:= $(PREFIX)objdump
SIZE        := $(PREFIX)size
GDB		    := gdb-multiarch

PYTHON := python3

OPTSRC = -O2

TARGET_HEX = $(out-dir)/$(TARGET).hex
TARGET_SIZE = $(out-dir)/$(TARGET).size
TARGET_BIN = $(out-dir)/$(TARGET).bin
TARGET_ELF = $(out-dir)/$(TARGET).elf
TARGET_LIST = $(out-dir)/$(TARGET).list
TARGET_MAP = $(out-dir)/$(TARGET).map
TARGET_IMG = $(out-dir)/$(TARGET).img

#头文件文件目录
INC_DIR += -Iinclude
INC_DIR += -Iarch/$(ARCH)/include
INC_DIR += -I$(out-dir)/include
INC_DIR += -Iapp/lua/lib
INC_DIR += -Iapp/lvgl/lib

CCFLAGS = $(ARCH_FLAGS)
CCFLAGS += $(FP_FLAGS)
CCFLAGS += $(OPTSRC)
CCFLAGS += -fmessage-length=0 -fsigned-char -ffunction-sections
CCFLAGS += -fdata-sections -ffreestanding -fno-move-loop-invariants
CCFLAGS += -g3
CCFLAGS += -Wno-unused-parameter
CCFLAGS += -Wno-unused-function
CCFLAGS += -Wno-unused-variable
CCFLAGS += -Wno-array-bounds
CCFLAGS += -fno-omit-frame-pointer

# 编译器特定选项
ifeq ($(CONFIG_CC_IS_CLANG),y)
    # Clang 特定选项
    CCFLAGS += -Wno-address-of-packed-member
    CCFLAGS += -Wno-gnu-variable-sized-type-not-at-end
    CCFLAGS += -Wno-format-invalid-specifier
    CCFLAGS += -Wno-tautological-constant-out-of-range-compare
    CCFLAGS += -Wno-unaligned-access
    CCFLAGS += -Wno-initializer-overrides
    CCFLAGS += -Wno-format-security
    CCFLAGS += -Wno-sign-compare
    CCFLAGS += -Wno-format-zero-length
    
    # Clang 优化选项
    CCFLAGS += -fno-builtin-memcpy
    CCFLAGS += -fno-builtin-memset
    CCFLAGS += -fno-builtin-memmove
    
    # Clang 不支持某些 GCC 特定选项
    ifneq ($(ARCH),arm64)
        CCFLAGS += -mno-global-merge
    endif
    
    # Clang 特定的代码生成选项
    CCFLAGS += -fno-addrsig
    CCFLAGS += -fno-jump-tables
else
    # GCC 特定选项
    CCFLAGS += -mapcs-frame
    CCFLAGS += -Wa,-mimplicit-it=thumb
    CCFLAGS += -fno-delete-null-pointer-checks
    CCFLAGS += -fno-var-tracking-assignments
    CCFLAGS += -fno-strict-overflow
    CCFLAGS += -fconserve-stack
    
    # GCC 警告控制
    ifeq ($(CONFIG_CC_HAS_WARN_MAYBE_UNINITIALIZED),y)
        CCFLAGS += -Wno-maybe-uninitialized
    endif
    CCFLAGS += -Wno-unused-but-set-variable
    CCFLAGS += -Wno-stringop-truncation
    
    # GCC 优化选项
    CCFLAGS += -fno-tree-loop-im
    CCFLAGS += -fno-merge-all-constants
endif

#CCFLAGS += -nostdinc
CCFLAGS += -std=gnu11 -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@)" -c
CCFLAGS += $(INC_DIR)
CCFLAGS += $(DEFINES)

ASFLAGS = $(ARCH_FLAGS)
ASFLAGS += $(FP_FLAGS)
ASFLAGS += $(OPTSRC)
ASFLAGS += -fmessage-length=0 -fsigned-char -ffunction-sections
ASFLAGS += -fdata-sections -ffreestanding -fno-move-loop-invariants
ASFLAGS += -Wall -Wextra -Werror -x assembler-with-cpp
ASFLAGS += -g3

# 汇编器编译器特定选项
ifeq ($(CONFIG_CC_IS_CLANG),y)
    # Clang 汇编器选项
    # Clang 集成汇编器不需要某些 GCC 特定选项
else
    # GCC 汇编器选项
    ASFLAGS += -Wa,-mimplicit-it=thumb
endif

ASFLAGS += -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@)" -c
ASFLAGS += $(INC_DIR)
ASFLAGS += $(DEFINES)

LDFLAGS = $(ARCH_FLAGS)
LDFLAGS += $(FP_FLAGS)
LDFLAGS += -nostdinc
LDFLAGS += -Wl,--start-group -Wl,--end-group -Wl,-cref,-u,Reset_Handler
LDFLAGS += -Wl,-gc-sections
LDFLAGS += -Wl,-Map=$(TARGET_MAP)
LDFLAGS += -Wl,--defsym=malloc_getpagesize_P=0x80

LDFLAGS-LIB = -lgcc -lc -lm