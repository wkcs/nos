# Verify that architecture modules supply matching compile/link ABI flags.
set(CONFIG_ARM_CORTEX_M4 TRUE)
set(CONFIG_ARM_CORTEX_M4_FPU TRUE)
set(CONFIG_THUMB2_KERNEL TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/../arch/arm/compiler_flags.cmake")
if(NOT "${NOS_ARCH_FLAGS};${NOS_FP_FLAGS}" STREQUAL "-march=armv7e-m;-mcpu=cortex-m4;-mthumb;-mfloat-abi=hard;-mfpu=fpv4-sp-d16")
    message(FATAL_ERROR "Incorrect Cortex-M4F flags: ${NOS_ARCH_FLAGS};${NOS_FP_FLAGS}")
endif()
set(NOS_ARCH_FLAGS "")
set(NOS_FP_FLAGS "")
set(NOS_GLOBAL_DEFINES "")
set(CONFIG_ARM64_CORTEX_A53 TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/../arch/arm64/compiler_flags.cmake")
if(NOT "${NOS_ARCH_FLAGS}" STREQUAL "-march=armv8-a;-mcpu=cortex-a53")
    message(FATAL_ERROR "Incorrect ARM64 flags: ${NOS_ARCH_FLAGS}")
endif()
set(NOS_ARCH_FLAGS "")
set(NOS_GLOBAL_DEFINES "")
set(CONFIG_RISCV_32IMAC TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/../arch/riscv/compiler_flags.cmake")
if(NOT "${NOS_ARCH_FLAGS}" STREQUAL "-march=rv32imac;-mabi=ilp32")
    message(FATAL_ERROR "Incorrect RISC-V flags: ${NOS_ARCH_FLAGS}")
endif()
set(NOS_ARCH_FLAGS "")
set(NOS_GLOBAL_DEFINES "")
include("${CMAKE_CURRENT_LIST_DIR}/../arch/x86/compiler_flags.cmake")
if(NOT "-mno-red-zone" IN_LIST NOS_ARCH_FLAGS)
    message(FATAL_ERROR "x86 kernel red zone is not disabled")
endif()
