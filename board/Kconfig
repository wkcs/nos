#
# 板级配置
#

choice
	prompt "Target Board"
	default BOARD_NK60
	help
	  选择目标板。

config BOARD_NK60
	bool "NK60 V2"
	depends on ARCH_ARM
	help
	  NK60 V2 键盘板。

config BOARD_QEMU_STM32
	bool "QEMU STM32"
	depends on ARCH_ARM
	help
	  QEMU STM32 仿真板。

config BOARD_WL_001
	bool "WL-001"
	depends on ARCH_ARM
	help
	  WL-001 板。

config BOARD_ZJ_V3
	bool "ZJ V3"
	depends on ARCH_ARM
	help
	  ZJ V3 板。

config BOARD_NUTINY_NUC472
	bool "NuTiny-SDK-NUC472"
	depends on ARCH_ARM

config BOARD_QEMU_VIRT
	bool "QEMU Virt"
	depends on ARCH_ARM || ARCH_ARM64 || ARCH_RISCV || ARCH_X86
	help
	  QEMU Virt 通用仿真板。

endchoice

config BOARD
	string
	default "nk60-v2" if BOARD_NK60
	default "qemu-stm32" if BOARD_QEMU_STM32
	default "wl-001" if BOARD_WL_001
	default "zj-v3" if BOARD_ZJ_V3
	default "nutiny-nuc472" if BOARD_NUTINY_NUC472
	default "qemu-virt" if BOARD_QEMU_VIRT

config QEMU
	bool "Target runs under QEMU emulator"
	default y if BOARD_QEMU_STM32 || BOARD_QEMU_VIRT
	default n
	help
	  启用针对 QEMU 仿真环境的初始化与半主机/外设适配。

# 服务器配置
menu "Server Configuration"

config NLK_SERVER
	bool "NLK (NOS Link Kit) distributed soft-bus server"
	default y if BOARD_NK60
	default n
	help
	  启用 NLK (NOS Link Kit) 分布式软总线协议栈与能力服务（替代原 NDK 与 Connect Server）。

if NLK_SERVER

config NLK_PACKET_MTU
	int "NLK maximum L3 payload size (bytes)"
	default 256
	help
	  单个 NLK L3 报文的最大有效载荷字节数。

config NLK_MAX_BEARERS
	int "Maximum NLK physical bearers per node"
	default 6

config NLK_MAX_CAPS
	int "Maximum NLK capabilities per node"
	default 12

config NLK_MAX_CHILDREN
	int "Maximum cascaded child nodes tracked per node"
	default 8

endif

config NDK_SERVER
	bool "Legacy NDK server alias (selects NLK_SERVER)"
	default n
	select NLK_SERVER
	help
	  向后兼容配置项，自动启用 NLK_SERVER。

endmenu
