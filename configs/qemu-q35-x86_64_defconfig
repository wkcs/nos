# QEMU Q35/Virt x86_64 Configuration (Long Mode, 4-Level Paging + Microkernel + POSIX)
CONFIG_ARCH_X86=y
CONFIG_X86_64=y
CONFIG_BOARD_QEMU_VIRT=y
CONFIG_SOC_QEMU_VIRT=y
CONFIG_KERNEL_MICROKERNEL=y
CONFIG_MMU=y
CONFIG_LIBC_MUSL=y
CONFIG_POSIX=y
CONFIG_PAGE_SIZE=4096
CONFIG_SYS_TICK_MS=1
CONFIG_MAX_PRIORITY=32
CONFIG_IDEL_TASK_STACK_SIZE=2048
CONFIG_CORE_TASK_STACK_SIZE=8192
CONFIG_SHELL=y
CONFIG_VFS=y
CONFIG_RAMFS=y
CONFIG_PROCFS=y
CONFIG_SYSFS=y
