CONFIG_USB=y
CONFIG_USB_DEVICE=y
CONFIG_USB_HID=y
CONFIG_USB_DEVICE_HID_KEYBOARD=y
CONFIG_USB_CDC=n
CONFIG_USB_WINUSB=y
CONFIG_USB_DEVICE_COMPOSITE=y
CONFIG_UART_DMA=n
CONFIG_KEYBOARD=y
CONFIG_NK60_V2_KEY=y
CONFIG_DISPLAY_SERVER=y
