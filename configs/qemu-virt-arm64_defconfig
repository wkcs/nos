# QEMU Virt ARM64 Configuration (Cortex-A53 Higher-Half Hybrid Kernel)
CONFIG_ARCH_ARM64=y
CONFIG_ARM64_CORTEX_A53=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS=39
CONFIG_ARM64_PA_BITS=40
CONFIG_ARM64_GICV3=y
CONFIG_ARM64_KERNEL_NO_FP=y
CONFIG_BOARD_QEMU_VIRT=y
CONFIG_SOC_QEMU_VIRT=y
CONFIG_QEMU=y
CONFIG_KERNEL_MICROKERNEL=y
CONFIG_MMU=y
CONFIG_LIBC_MUSL=y
CONFIG_POSIX=y
CONFIG_PAGE_SIZE=4096
CONFIG_SYS_TICK_MS=1
CONFIG_MAX_PRIORITY=32
CONFIG_STACK_GROWSUP=n
CONFIG_IDEL_TASK_STACK_SIZE=4096
CONFIG_CORE_TASK_STACK_SIZE=16384
CONFIG_MAX_ORDER=10
CONFIG_KALLSYMS=y
CONFIG_STACK_BACKTRACE=y
CONFIG_TTY=y
CONFIG_DEFAULT_CONSOLE="tty0"
CONFIG_CONSOLE_CRLF=y
CONFIG_UART_RX_BUFFER_SIZE=256
CONFIG_UART_TX_BUFFER_SIZE=512
CONFIG_DEFAULT_LOG_LEVEL=0
CONFIG_SHELL=y
CONFIG_SHELL_CONSOLE=y
CONFIG_SHELL_STACK_SIZE=16384
CONFIG_DEVICE_TREE=y
CONFIG_VFS=y
CONFIG_RAMFS=y
CONFIG_PROCFS=y
CONFIG_SYSFS=y
CONFIG_VFS_SMOKE_TEST=y
