# QEMU Virt ARM64 Configuration (Cortex-A53, MMU + Microkernel + POSIX)
CONFIG_ARCH_ARM64=y
CONFIG_ARM64_CORTEX_A53=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS=39
CONFIG_ARM64_PA_BITS=40
CONFIG_BOARD_QEMU_VIRT=y
CONFIG_SOC_QEMU_VIRT=y
CONFIG_KERNEL_MICROKERNEL=y
CONFIG_MMU=y
CONFIG_LIBC_MUSL=y
CONFIG_POSIX=y
CONFIG_PAGE_SIZE=4096
CONFIG_SYS_TICK_MS=1
CONFIG_MAX_PRIORITY=32
CONFIG_IDEL_TASK_STACK_SIZE=2048
CONFIG_CORE_TASK_STACK_SIZE=8192
CONFIG_SHELL=y
CONFIG_DEVICE_TREE=y
CONFIG_VFS=y
CONFIG_RAMFS=y
CONFIG_PROCFS=y
CONFIG_SYSFS=y
