# QEMU STM32 Board Configuration (QEMU netduinoplus2: STM32F405 / Cortex-M4F)
CONFIG_ARCH_ARM=y
CONFIG_ARM_CORTEX_M4=y
CONFIG_ARM_CORTEX_M4_FPU=y
CONFIG_THUMB2_KERNEL=y
CONFIG_KERNEL_USE_BOOTLOADER=n
CONFIG_QEMU=y
CONFIG_BOARD_QEMU_STM32=y
CONFIG_SOC_STM32F4=y
CONFIG_PAGE_SIZE=4096
CONFIG_SYS_TICK_MS=10
CONFIG_MAX_PRIORITY=256
CONFIG_STACK_GROWSUP=n
CONFIG_IDEL_TASK_STACK_SIZE=1024
CONFIG_CORE_TASK_STACK_SIZE=4096
CONFIG_MMU=n
CONFIG_MM_DEBUG=y
CONFIG_MAX_ORDER=9
CONFIG_SPINLOCK_DEBUG=y
CONFIG_DEFAULT_CONSOLE="tty0"
CONFIG_LOG_FIFO_BUF_SIZE=512
CONFIG_CONSOLE_FIFO_BUF_SIZE=512
CONFIG_DEFAULT_LOG_LEVEL=0
CONFIG_SHELL=y
CONFIG_USB=n
CONFIG_UART_DMA=n
CONFIG_KEYBOARD=n
CONFIG_DISPLAY_SERVER=n
CONFIG_LVGL=n
CONFIG_LUA=n
CONFIG_TEST_APP=n
CONFIG_VFS=y
CONFIG_RAMFS=y
CONFIG_PROCFS=y
CONFIG_SYSFS=y
CONFIG_RAMDISK=y
CONFIG_FATFS=y
CONFIG_SPI=y
CONFIG_QEMU_SD=y
CONFIG_CONNECT_SERVER=n
CONFIG_NDK_SERVER=n
