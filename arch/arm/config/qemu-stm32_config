CONFIG_CPU_TYPE="cortex-m3"
CONFIG_BOARD="qemu-stm32"
CONFIG_SOC_STM32F1=y
CONFIG_ARM_CORTEX_CPU=y
CONFIG_PAGE_SIZE=4096
CONFIG_DEFAULT_CONSOLE="tty0"
CONFIG_LOG_FIFO_BUF_SIZE=4096
CONFIG_DEFAULT_LOG_LEVEL=0
CONFIG_SYS_TICK_MS=10
CONFIG_MM_DEBUG=y
CONFIG_MAX_PRIORITY=256
CONFIG_STACK_GROWSUP=n
CONFIG_MAX_ORDER=9
CONFIG_SPINLOCK_DEBUG=y
CONFIG_THUMB2_KERNEL=y
CONFIG_QEMU=y
CONFIG_IDEL_TASK_STACK_SIZE=4096
CONFIG_CORE_TASK_STACK_SIZE=4096
# VFS path (FATFS/QEMU_SD until M3 ramdisk)
CONFIG_RAMDISK=y
CONFIG_FATFS=y
CONFIG_SPI=y
CONFIG_QEMU_SD=y
# Optional interactive shell
CONFIG_SHELL=y
# Slim golden: no test noise / USB / UI / display-heavy apps
CONFIG_TEST_APP=n
CONFIG_USB=n
CONFIG_LVGL=n
CONFIG_LUA=n
CONFIG_DISPLAY_SERVER=n
CONFIG_KEYBOARD=n
CONFIG_RGB_TEST=n
CONFIG_LCD_TEST=n
CONFIG_OLED_TEST=n
CONFIG_SDCARD_TEST=n
CONFIG_FATFS_TEST=n
CONFIG_CONNECT_SERVER=n
CONFIG_NDK_SERVER=n
