# QEMU STM32 默认配置

# 架构
CONFIG_ARCH_ARM=y
CONFIG_ARM_CORTEX_M3=y
CONFIG_THUMB2_KERNEL=y
CONFIG_KERNEL_USE_BOOTLOADER=n

# 板级
CONFIG_BOARD_QEMU_STM32=y

# 内核配置
CONFIG_PAGE_SIZE=4096
CONFIG_SYS_TICK_MS=1
CONFIG_MAX_PRIORITY=32
CONFIG_STACK_GROWSUP=n
CONFIG_IDEL_TASK_STACK_SIZE=1024
CONFIG_CORE_TASK_STACK_SIZE=4096

# 内存管理
CONFIG_MMU=n
CONFIG_MM_DEBUG=y
CONFIG_MAX_ORDER=9

# 同步
CONFIG_SPINLOCK_DEBUG=y

# 日志和控制台
CONFIG_DEFAULT_CONSOLE="tty0"
CONFIG_LOG_FIFO_BUF_SIZE=512
CONFIG_CONSOLE_FIFO_BUF_SIZE=512
CONFIG_DEFAULT_LOG_LEVEL=6

# Shell
CONFIG_SHELL=y

# 设备树
CONFIG_DEVICE_TREE=n

# USB
CONFIG_USB=n

# UART
CONFIG_UART_DMA=n

# 键盘
CONFIG_KEYBOARD=n

# 显示
CONFIG_DISPLAY_SERVER=n

# 文件系统
CONFIG_VFS=y
CONFIG_RAMFS=y
CONFIG_PROCFS=y
CONFIG_SYSFS=y
CONFIG_FATFS=n

# 服务器
CONFIG_CONNECT_SERVER=n
CONFIG_NDK_SERVER=n