# QEMU STM32 golden / default config (slim refactor path)

# 架构
CONFIG_ARCH_ARM=y
CONFIG_ARM_CORTEX_M3=y
CONFIG_THUMB2_KERNEL=y
CONFIG_KERNEL_USE_BOOTLOADER=n
CONFIG_QEMU=y

# 板级 / SoC
CONFIG_BOARD_QEMU_STM32=y
CONFIG_SOC_STM32F1=y

# 内核配置
CONFIG_PAGE_SIZE=4096
CONFIG_SYS_TICK_MS=10
CONFIG_MAX_PRIORITY=256
CONFIG_STACK_GROWSUP=n
CONFIG_IDEL_TASK_STACK_SIZE=4096
CONFIG_CORE_TASK_STACK_SIZE=4096

# 内存管理
CONFIG_MMU=n
CONFIG_MM_DEBUG=y
CONFIG_MAX_ORDER=9

# 同步
CONFIG_SPINLOCK_DEBUG=y

# 日志和控制台
CONFIG_DEFAULT_CONSOLE="tty0"
CONFIG_LOG_FIFO_BUF_SIZE=4096
CONFIG_CONSOLE_FIFO_BUF_SIZE=512
CONFIG_DEFAULT_LOG_LEVEL=0

# Shell (optional)
CONFIG_SHELL=y

# 设备树
CONFIG_DEVICE_TREE=n

# Slim: disable USB / UI / display / keyboard / test apps
CONFIG_USB=n
CONFIG_UART_DMA=n
CONFIG_KEYBOARD=n
CONFIG_DISPLAY_SERVER=n
CONFIG_LVGL=n
CONFIG_LUA=n
CONFIG_TEST_APP=n
CONFIG_RGB_TEST=n
CONFIG_LCD_TEST=n
CONFIG_OLED_TEST=n
CONFIG_SDCARD_TEST=n
CONFIG_FATFS_TEST=n

# 文件系统 (keep FATFS/QEMU_SD until M3 ramdisk)
CONFIG_VFS=y
CONFIG_RAMFS=y
CONFIG_PROCFS=y
CONFIG_SYSFS=y
CONFIG_FATFS=y
CONFIG_SPI=y
CONFIG_QEMU_SD=y

# 服务器
CONFIG_CONNECT_SERVER=n
CONFIG_NDK_SERVER=n
