# ARM64 架构特定编译选项
##############################################

# ARM64 架构特定编译选项

# 基础架构标志
ARCH_FLAGS := -march=armv8-a

# CPU 特定标志
ifeq ($(CONFIG_ARM64_CORTEX_A53),y)
    ARCH_FLAGS := -march=armv8-a -mcpu=cortex-a53
endif

ifeq ($(CONFIG_ARM64_CORTEX_A72),y)
    ARCH_FLAGS := -march=armv8-a -mcpu=cortex-a72
endif

ifeq ($(CONFIG_ARM64_GENERIC),y)
    ARCH_FLAGS := -march=armv8-a -mcpu=generic
endif

# 浮点和向量单元
FP_FLAGS := -mfloat-abi=hard

# 编译器特定的 ARM64 选项
ifeq ($(CONFIG_CC_IS_CLANG),y)
    # Clang ARM64 特定选项
    ARCH_FLAGS += -fno-integrated-as
    # Clang 对 ARM64 的特定处理
    ARCH_FLAGS += -fno-addrsig
    # 禁用某些可能有问题的优化
    ARCH_FLAGS += -fno-jump-tables
else
    # GCC ARM64 特定选项
    ARCH_FLAGS += -fno-delete-null-pointer-checks
    # GCC 特定的 ARM64 优化
    ARCH_FLAGS += -fno-asynchronous-unwind-tables
    ARCH_FLAGS += -fno-unwind-tables
endif

# 页面大小相关选项
ifeq ($(CONFIG_ARM64_4K_PAGES),y)
    DEFINES += -DCONFIG_ARM64_4K_PAGES
endif

ifeq ($(CONFIG_ARM64_64K_PAGES),y)
    DEFINES += -DCONFIG_ARM64_64K_PAGES
endif

# 虚拟地址空间配置
DEFINES += -DCONFIG_ARM64_VA_BITS=$(CONFIG_ARM64_VA_BITS)
DEFINES += -DCONFIG_ARM64_PA_BITS=$(CONFIG_ARM64_PA_BITS)

# 定义架构相关的宏
DEFINES += -D__ARM64__ -D__aarch64__

# 链接脚本
LDSCRIPT += arch/arm64/kernel/vmlinux.ld.S