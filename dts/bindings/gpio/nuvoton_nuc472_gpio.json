{
  "compatible": "nuvoton,nuc472-gpio",
  "properties": {
    "reg": {"type": "uint32-array", "required": true, "min-items": 2, "max-items": 2},
    "interrupts": {"type": "uint32-array", "required": false, "min-items": 1},
    "gpio-controller": {"type": "boolean", "required": true},
    "#gpio-cells": {"type": "uint32-array", "required": true, "min-items": 1, "max-items": 1},
    "status": {"type": "string", "enum": ["okay", "ok", "disabled", "reserved", "fail", "fail-sss"]}
  }
}
