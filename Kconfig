	bool "Enable LVGL graphics library"
	default n

config TEST_APP
	bool "Enable general test application"
	default n

config RGB_TEST
	bool "Enable RGB matrix test"
	default n

config LCD_TEST
	bool "Enable LCD test"
	default n

config OLED_TEST
	bool "Enable OLED test"
	default n

config FATFS_TEST
	bool "Enable FatFS test"
	default n

endmenu
