mainmenu "NOS Kernel Configuration"

config VERSION_CODE
	int
	default 65536
	help
	  内核版本代码，格式为 (VERSION << 16) | (PATCHLEVEL << 8) | SUBLEVEL

config BUILD_INFO
	string
	default ""
	help
	  构建时间信息

# 架构选择
source "arch/Kconfig"

# SoC 芯片选择
source "soc/Kconfig"

# 编译器选择
menu "Compiler Configuration"

choice
	prompt "Compiler Selection"
	default CC_IS_GCC
	help
	  选择用于编译内核的编译器。

config CC_IS_GCC
	bool "GCC (GNU Compiler Collection)"
	help
	  使用 GCC 编译器。这是默认选项，
	  支持所有架构和功能。

config CC_IS_CLANG
	bool "Clang (LLVM Compiler)"
	help
	  使用 Clang/LLVM 编译器。
	  提供更好的诊断信息和优化。

endchoice

config CC_VERSION_TEXT
	string
	default "gcc" if CC_IS_GCC
	default "clang" if CC_IS_CLANG
	help
	  编译器版本文本标识。

config CC_HAS_ASM_GOTO
	bool
	default y if CC_IS_GCC
	default y if CC_IS_CLANG
	help
	  编译器支持 asm goto 语句。

config CC_HAS_WARN_MAYBE_UNINITIALIZED
	bool
	default y if CC_IS_GCC
	default n if CC_IS_CLANG
	help
	  编译器支持 -Wmaybe-uninitialized 警告。

endmenu

# 内核核心配置
menu "Kernel Configuration"

choice
	prompt "Kernel Architecture Mode"
	default KERNEL_MONOLITHIC
	help
	  选择内核运行架构模式：传统宏内核/RTOS 模式，或 Capability 微内核模式。

config KERNEL_MONOLITHIC
	bool "Monolithic / Classic RTOS kernel"
	help
	  传统单地址空间或宏内核模式，所有核心服务运行于内核态。

config KERNEL_MICROKERNEL
	bool "Capability-based Microkernel"
	help
	  微内核模式：内核仅保留线程调度、同步 Endpoint IPC、Notification、
	  Capability 句柄表、MMU/MPU 地址空间隔离与用户态 IRQ 转发。

endchoice

config SMP
	bool "Symmetric Multi-Processing (SMP) support"
	default n
	help
	  启用多核 SMP 支持。

config NR_CPUS
	int "Maximum number of CPUs"
	default 4 if SMP
	default 1
	range 1 8
	help
	  系统支持的最大 CPU 核心数。单核模式下固定为 1。

config SCHED_FAIR
	bool "Enable CFS/EEVDF Fair Scheduling Class (SCHED_NORMAL)"
	default y
	help
	  启用基于虚拟运行时间 (vruntime) 与 Nice 权重的公平调度类，与实时调度类并存。

config SCHED_CPULOAD
	bool "Track task CPU load statistics"
	default y
	help
	  启用任务 CPU 负载统计。

config KALLSYMS
	bool "Enable kernel symbol table lookup (kallsyms)"
	default y
	help
	  启用内核符号表查找，用于栈回溯、WCHAN 显示与异常现场解析。

config STACK_BACKTRACE
	bool "Enable cross-task stack backtrace and crash unwinder"
	default y
	help
	  启用零堆分配的双模栈回溯器（支持 Frame Pointer 与栈代码地址扫描）。

config BACKTRACE_MAX_DEPTH
	int "Maximum stack backtrace frame depth"
	depends on STACK_BACKTRACE
	default 12
	range 4 32
	help
	  栈回溯最大帧深度。

config PAGE_SIZE
	int "Page size"
	default 4096
	help
	  系统页面大小（字节）。
	  通常为 4096 字节。

config SYS_TICK_MS
	int "System tick period (ms)"
	default 1
	range 1 1000
	help
	  系统时钟滴答周期（毫秒）。
	  较小的值提供更好的响应性，但增加开销。

config MAX_PRIORITY
	int "Maximum task priority levels"
	default 32
	range 8 256
	help
	  任务优先级级别数量。
	  更多级别提供更细粒度的调度控制。

config STACK_GROWSUP
	bool "Stack grows upward"
	default n
	help
	  如果启用，栈向上增长（从低地址到高地址）。
	  大多数架构栈向下增长。

config IDEL_TASK_STACK_SIZE
	int "Idle task stack size"
	default 1024
	range 512 8192
	help
	  空闲任务的栈大小（字节）。

config CORE_TASK_STACK_SIZE
	int "Core task stack size"
	default 4096
	range 1024 16384
	help
	  核心任务的栈大小（字节）。

endmenu

# 内存管理配置
menu "Memory Management"

config MMU
	bool "Enable MMU support"
	default n
	depends on ARCH_HAS_MMU
	help
	  启用内存管理单元（MMU）支持。
	  提供虚拟内存、内存保护等功能。

config MPU
	bool "Enable MPU / PMP memory protection"
	default n
	depends on ARCH_HAS_MPU
	help
	  启用硬件 MPU (ARM Cortex-M) 或 PMP (RISC-V) 内存保护单元。

config MPU_STACK_GUARD
	bool "Enable 32-byte hardware MPU task stack guard"
	default y
	depends on MPU
	help
	  使用硬件 MPU Region 5 在当前运行任务栈底设置 32 字节禁访红区，实时捕获栈溢出。

config MM_TLSF
	bool "Enable TLSF O(1) low-fragmentation allocator"
	default y if !MMU
	help
	  启用 TLSF 二级位图紧凑边界标记分配器，消除页截断浪费与小内存碎片。

config MM_SLUB
	bool "Enable SLUB kmem_cache small-object allocator"
	default y
	help
	  启用 Linux 风格 SLUB (kmem_cache) 小对象分配器，支持与 Buddy/TLSF 并存。

config MM_DEBUG
	bool "Memory management debugging"
	default n
	help
	  启用内存管理调试功能。
	  包括内存泄漏检测、边界检查等。

config MAX_ORDER
	int "Maximum buddy allocator order"
	default 9
	range 5 15
	help
	  Buddy 分配器的最大阶数。
	  最大可分配块大小为 PAGE_SIZE * (2^MAX_ORDER)。

endmenu

# 标准库与 POSIX 兼容层配置
menu "Standard C Library (libc) and POSIX"

choice
	prompt "C Standard Library Selection"
	default LIBC_NEWLIB if ARCH_ARM
	default LIBC_MUSL if ARCH_ARM64 || ARCH_RISCV || ARCH_X86
	help
	  选择使用的 C 标准库实现。

config LIBC_MINIMAL
	bool "NOS Minimal internal klibc only"
	help
	  仅使用内核内置精简 string/vsprintf，不链接外部完整 libc。

config LIBC_NEWLIB
	bool "Toolchain Newlib / Newlib-nano"
	help
	  使用交叉编译工具链自带的 Newlib / Newlib-nano，通过 libs/libc/port 对接。

config LIBC_PICOLIBC
	bool "Picolibc (Lightweight embedded C library)"
	help
	  使用专为嵌入式优化的 Picolibc 标准库。

config LIBC_MUSL
	bool "musl libc (Full POSIX standard library for MMU targets)"
	depends on MMU || ARCH_ARM64 || ARCH_RISCV || ARCH_X86
	help
	  在带 MMU 的架构上使用完整的 musl C 标准库。

endchoice

config POSIX
	bool "Enable POSIX API compatibility layer (pthread, fd, signal, timer, mmap)"
	default y if LIBC_MUSL
	default n
	help
	  启用统一的 POSIX 兼容层接口。

endmenu

# 同步原语配置
menu "Synchronization"

config SPINLOCK_DEBUG
	bool "Spinlock debugging"
	default n
	help
	  启用自旋锁调试功能。
	  检测死锁、长时间持锁等问题。

endmenu

# 日志和控制台配置
menu "Logging and Console"

config DEFAULT_CONSOLE
	string "Default console device"
	default "tty0"
	help
	  默认控制台设备名称。

config CONSOLE_CRLF
	bool "Translate console LF to CRLF"
	default y
	help
	  串口控制台的文本输出将 LF 转换为 CRLF，适用于 minicom 等终端。
	  关闭后保持 LF；原始 UART 和文件数据不受影响。

config LOG_BUFFERED
	bool "Buffer complete log records"
	depends on !(ARCH_ARM64 && BOARD_QEMU_VIRT)
	default y
	help
	  使用固定大小的记录队列吸收串口突发输出。
	  ARM64 QEMU virt 当前只有 PL011 轮询端口，尚不支持后台排空。

config LOG_FIFO_BUF_SIZE
	int "Log FIFO buffer size"
	depends on LOG_BUFFERED
	default 512
	range 128 65536
	help
	  日志记录队列大小（字节），必须是 2 的幂。

config LOG_MESSAGE_SIZE
	int "Maximum formatted log message size"
	default 128 if BOARD_WL_001
	default 256 if ARCH_ARM
	default 512
	range 64 4096
	help
	  每次日志调用使用的格式化空间（字节，包含结尾 NUL）。

config LOG_COMPILE_LEVEL
	int "Compile-time minimum log severity"
	default 0
	range 0 6
	help
	  低于该级别的日志在编译时移除，参数也不会求值。
	  0=ALL, 1=DEBUG, 2=INFO, 3=WARNING, 4=ERROR, 5=FATAL, 6=OFF。

config DEFAULT_LOG_LEVEL
	int "Default log level"
	default 0
	range 0 6
	help
	  最低输出严重性（包含该级别）。
	  0=ALL, 1=DEBUG, 2=INFO, 3=WARNING, 4=ERROR, 5=FATAL, 6=OFF。

endmenu

# 终端和 Shell 配置
menu "Terminal"

config TTY
	bool "Raw TTY support"
	default y
	help
	  启用可裁剪的原始终端字节流；行编辑由 Shell 或上层服务负责。

config TTY_CANONICAL
	bool "Canonical TTY input and echo"
	depends on TTY
	default n
	help
	  可选的行缓冲、退格、回显和回车转换；默认仍为 raw 模式。

config TTY_LINE_SIZE
	int "Canonical TTY line buffer size"
	depends on TTY_CANONICAL
	default 128
	range 8 4096

endmenu

menu "Shell"

config SHELL
	bool "Enable shell"
	depends on TTY
	default n
	help
	  启用交互式 Shell 命令行界面。

config SHELL_STACK_SIZE
	int "Shell task stack size"
	depends on SHELL
	default 2048
	range 1024 65536

config SHELL_OUTPUT_SIZE
	int "Shell formatted output size"
	depends on SHELL
	default 256
	range 64 4096

config SHELL_PIPE_TEST
	bool "Shell stream pipe concurrency test"
	depends on QEMU && BOARD_QEMU_STM32
	default n
	help
	  Exercise shell pipe backpressure and EOF using scheduled QEMU tasks.

endmenu

# 测试配置
menu "Kernel Testing"

config KERNEL_TESTS
	bool "Enable kernel tests"
	default n
	help
	  启用内核测试框架。
	  包括属性测试和单元测试。

config PROPERTY_TESTS
	bool "Enable property-based tests"
	default y
	depends on KERNEL_TESTS
	help
	  启用基于属性的测试。
	  验证系统的通用正确性属性。

endmenu

# 设备树支持
menu "Device Tree"

config DEVICE_TREE
	bool "Enable device tree support"
	default n
	help
	  启用设备树（Device Tree）支持。
	  允许通过设备树描述硬件配置。

endmenu

