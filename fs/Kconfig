#
# 文件系统配置
#

menu "File Systems"

config VFS
	bool "Virtual File System (VFS)"
	default y
	help
	  启用虚拟文件系统层。
	  提供统一的文件操作接口。

config VFS_SMOKE_TEST
	bool "VFS boot smoke test"
	depends on VFS
	default n
	help
	  Create and read back /smoke.txt during application initialization.

config VFS_FD_CONCURRENCY_TEST
	bool "VFS descriptor concurrency test"
	depends on VFS && QEMU && BOARD_QEMU_STM32
	default n
	help
	  Exercise shared file offsets using scheduled tasks in QEMU.

config RAMFS
	bool "RAM file system"
	default y
	depends on VFS
	help
	  启用内存文件系统。

config PROCFS
	bool "Proc file system"
	default y
	depends on VFS
	help
	  启用 /proc 文件系统。
	  导出进程和系统信息。

config SYSFS
	bool "Sys file system"
	default y
	depends on VFS
	help
	  启用 /sys 文件系统。
	  导出设备和驱动信息。

config FATFS
	bool "FAT file system"
	default n
	depends on VFS
	help
	  启用 FAT 文件系统支持（FAT12/FAT16/FAT32）。

endmenu
