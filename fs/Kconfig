#
# 文件系统配置
#

menu "File Systems"

config VFS
	bool "Virtual File System (VFS)"
	default y
	help
	  启用虚拟文件系统层。
	  提供统一的文件操作接口。

config VFS_SMOKE_TEST
	bool "VFS boot smoke test"
	depends on VFS
	default n
	help
	  Create and read back /smoke.txt during application initialization.

config VFS_FD_CONCURRENCY_TEST
	bool "VFS descriptor concurrency test"
	depends on VFS && QEMU && BOARD_QEMU_STM32
	default n
	help
	  Exercise shared file offsets using scheduled tasks in QEMU.

config VFS_FAT_ALIAS_TEST
	bool "FatFs alias identity test"
	depends on VFS && FATFS && QEMU && BOARD_QEMU_STM32
	default n
	help
	  Test cached FatFs aliases, removal, rename, and mount protection.

config RAMFS
	bool "RAM file system"
	default y
	depends on VFS
	help
	  启用内存文件系统。

config PROCFS
	bool "Proc file system"
	default y
	depends on VFS
	help
	  启用 /proc 文件系统。
	  导出进程和系统信息。

config SYSFS
	bool "Sys file system"
	default y
	depends on VFS
	help
	  启用 /sys 文件系统。
	  导出设备和驱动信息。

config FATFS
	bool "FAT file system"
	default n
	depends on VFS
	help
	  启用 FAT 文件系统支持（FAT12/FAT16/FAT32）。

config FATFS_CODEPAGE
	int "FatFs OEM code page"
	default 936
	depends on FATFS
	help
	  FatFs OEM 代码页（例如 936 为简体中文 GBK，437 为美式单字节编码以节省 Flash）。

config LITTLEFS
	bool "LittleFS file system"
	default y if BOARD_NK60 || BOARD_NK60_V1
	default n
	depends on VFS
	help
	  启用 LittleFS 文件系统支持（专为 MCU 与 NOR Flash 设计的轻量级掉电安全文件系统）。

config ASSETS_FS_LITTLEFS
	bool "Mount LittleFS on /assets"
	default y if LITTLEFS && (BOARD_NK60 || BOARD_NK60_V1)
	default n
	depends on LITTLEFS
	help
	  在系统引导阶段，将 W25Q assets 分区以 LittleFS 文件系统格式挂载至 /assets。

endmenu
